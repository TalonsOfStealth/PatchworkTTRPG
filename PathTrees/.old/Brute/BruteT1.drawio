        <mxCell id="gStQc3uPt2lsnkzCg7Po-34" parent="gStQc3uPt2lsnkzCg7Po-32" style="rounded=1;whiteSpace=wrap;align=left;fillColor=none;strokeColor=light-dark(#FFFFFF,#FFFFFF);fontColor=light-dark(#000000,#000000);dashed=1;dashPattern=8 4 1 4;gradientColor=none;gradientDirection=radial;perimeterSpacing=0;glass=0;shadow=0;strokeWidth=1;fillStyle=solid;imageAspect=1;textShadow=0;labelPosition=center;verticalLabelPosition=middle;verticalAlign=top;labelBackgroundColor=none;html=1;fontFamily=Alegreya;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DAlegreya;fontSize=14;spacingLeft=5;spacingBottom=0;spacingTop=0;spacingRight=5;labelPadding=0;perimeter=rectanglePerimeter;" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;You&#39;re Next (2 XP)  [&amp;nbsp; ]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;font&gt;&lt;i&gt;(&lt;b&gt;1&lt;/b&gt;/Activation&lt;/i&gt;&lt;/font&gt;&lt;font&gt;&lt;i&gt;)&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;&lt;div align=&quot;justify&quot;&gt;&lt;font&gt;&lt;font&gt;After killing &lt;b&gt;2&lt;/b&gt; creatures (or causing them to flee), with the same attack, one creature of your choice that can see you becomes &lt;b&gt;frightened&lt;/b&gt; until the end of it&#39;s next activation.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
